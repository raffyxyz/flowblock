  "fixed_sql": [
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"notes\" TEXT NULL, \"sort_order\" INTEGER NOT NULL, \"is_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_done\" IN (0, 1)), \"completed_at\" INTEGER NULL, \"estimated_seconds\" INTEGER NULL, \"scheduled_date\" TEXT NULL, \"scheduled_minutes\" INTEGER NULL, \"recurrence_type\" TEXT NOT NULL DEFAULT 'once', \"recurrence_interval\" INTEGER NOT NULL DEFAULT 1, \"recurrence_weekdays\" INTEGER NOT NULL DEFAULT 0, \"recurrence_ends_on\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "subtasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subtasks\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, \"is_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_done\" IN (0, 1)), \"completed_at\" INTEGER NULL, \"duration_seconds\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "task_occurrences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_occurrences\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"date\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', \"completed_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "occurrence_subtask_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"occurrence_subtask_states\" (\"occurrence_id\" TEXT NOT NULL REFERENCES task_occurrences (id) ON DELETE CASCADE, \"subtask_id\" TEXT NOT NULL REFERENCES subtasks (id) ON DELETE CASCADE, \"is_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_done\" IN (0, 1)), \"completed_at\" INTEGER NULL, PRIMARY KEY (\"occurrence_id\", \"subtask_id\"));"
        }
      ]
    },
    {
      "name": "timer_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"timer_sessions\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"subtask_id\" TEXT NULL REFERENCES subtasks (id) ON DELETE SET NULL, \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NULL, \"planned_seconds\" INTEGER NOT NULL, \"elapsed_seconds\" INTEGER NOT NULL DEFAULT 0, \"mode\" TEXT NOT NULL DEFAULT 'countdown', \"end_reason\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks_scheduled_date",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX tasks_scheduled_date ON tasks (scheduled_date)"
        }
      ]
    },
    {
      "name": "subtasks_task_order",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX subtasks_task_order ON subtasks (task_id, sort_order)"
        }
      ]
    },
    {
      "name": "occurrences_date",
      "sql": [
        {
